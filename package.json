{
	"name": "portfolio",
	"type": "module",
	"version": "0.0.5",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "bun test",
		"prepush:ci": "bun run scripts/security/prepush-ci.mjs",
		"lint": "astro check",
		"format": "prettier --write .",
		"security:check-config": "bun run scripts/security/check-bun-hardening.mjs",
		"security:check-exceptions-expiry": "bun run scripts/security/check-exceptions-expiry.mjs --warn-days 14 --enforce true",
		"security:audit": "bun audit",
		"security:enforce-osv": "bun run scripts/security/enforce-osv-policy.mjs",
		"security:enforce-audit": "bun run scripts/security/enforce-audit-policy.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/react": "6.0.6",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/tailwind": "6.0.2",
		"@astrojs/ts-plugin": "1.10.12",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "7.3.3",
		"babel-plugin-react-compiler": "1.0.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.46.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"tailwindcss-animate": "1.0.7",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"bun-types": "1.4.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"prettier": "3.9.7",
		"prettier-plugin-astro": "1.0.1",
		"prettier-plugin-tailwindcss": "0.8.1"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"esbuild",
		"sharp"
	]
}
