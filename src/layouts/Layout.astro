---
import { avatar } from '@/lib/utils'
type Props = {
	title: string
	description?: string
}

const {
	title,
	description = 'Portfolio de Amyssyko, desarrollador de software y data scientist. Explora mis proyectos, experiencia laboral y habilidades técnicas.'
} = Astro.props

const siteUrl = Astro.site ?? new URL(Astro.url.origin)
const siteRootUrl = new URL('/', siteUrl).href
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href
const avatarUrl = new URL(avatar.src, siteUrl).href

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${siteRootUrl}#person`,
	name: 'Amyssyko',
	url: siteRootUrl,
	image: avatarUrl,
	description: 'Desarrollador de software y data scientist.',
	sameAs: ['https://github.com/Amyssyko', 'https://x.com/Amyssyko']
}

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${siteRootUrl}#website`,
	name: 'Portfolio de Amyssyko',
	url: siteRootUrl,
	inLanguage: 'es',
	author: {
		'@id': `${siteRootUrl}#person`
	}
}
---

<html lang='es'>
	<head>
		<meta charset='UTF-8' />
		<meta
			name='viewport'
			content='width=device-width, initial-scale=1'
		/>

		<title>{title}</title>
		<meta
			name='description'
			content={description}
		/>
		<meta
			name='author'
			content='Amyssyko'
		/>
		<meta
			name='theme-color'
			content='#111827'
		/>

		<link
			rel='canonical'
			href={canonicalUrl}
		/>

		<!-- Open Graph -->
		<meta
			property='og:type'
			content='website'
		/>
		<meta
			property='og:site_name'
			content='Portfolio de Amyssyko'
		/>
		<meta
			property='og:locale'
			content='es_ES'
		/>
		<meta
			property='og:url'
			content={canonicalUrl}
		/>
		<meta
			property='og:title'
			content={title}
		/>
		<meta
			property='og:description'
			content={description}
		/>
		<meta
			property='og:image'
			content={avatarUrl}
		/>
		<meta
			property='og:image:alt'
			content='Avatar de Amyssyko'
		/>

		<!-- Twitter / X -->
		<meta
			name='twitter:card'
			content='summary_large_image'
		/>
		<meta
			name='twitter:site'
			content='@Amyssyko'
		/>
		<meta
			name='twitter:creator'
			content='@Amyssyko'
		/>
		<meta
			name='twitter:url'
			content={canonicalUrl}
		/>
		<meta
			name='twitter:title'
			content={title}
		/>
		<meta
			name='twitter:description'
			content={description}
		/>
		<meta
			name='twitter:image'
			content={avatarUrl}
		/>
		<meta
			name='twitter:image:alt'
			content='Avatar de Amyssyko'
		/>
		<meta
			name='robots'
			content='index,follow'
		/>
		<script is:inline>
			const getThemePreference = () => {
				if (
					typeof localStorage !== 'undefined' &&
					localStorage.getItem('theme')
				) {
					return localStorage.getItem('theme')
				}

				return window.matchMedia('(prefers-color-scheme: dark)').matches ?
						'dark'
					:	'light'
			}

			const isDark = getThemePreference() === 'dark'
			document.documentElement.classList[isDark ? 'add' : 'remove']('dark')

			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const darkEnabled =
						document.documentElement.classList.contains('dark')
					localStorage.setItem('theme', darkEnabled ? 'dark' : 'light')
				})

				observer.observe(document.documentElement, {
					attributes: true,
					attributeFilter: ['class']
				})
			}
		</script>
		<script
			is:inline
			type='application/ld+json'
			set:html={JSON.stringify(personSchema)}
		/>
		<script
			is:inline
			type='application/ld+json'
			set:html={JSON.stringify(websiteSchema)}
		/>
		<link
			rel='icon'
			href='/favicon.svg'
			media='(prefers-color-scheme: light)'
		/>
		<!-- Dark mode favicon -->
		<link
			rel='icon'
			type='image/svg+xml'
			href='/favicon-dark.svg'
			media='(prefers-color-scheme: dark)'
		/>
		<!-- Fallback favicon (for browsers that don't support prefers-color-scheme or when no preference is set) -->
		<link
			rel='icon'
			href='/favicon.svg'
			type='image/svg+xml'
		/>
		<meta
			name='generator'
			content={Astro.generator}
		/>
	</head>
	<body class='gap-y-12 md:gap-y-36 grid grid-rows-[auto_1fr_auto] w-full min-h-dvh max-h-full overflow-x-clip'>
		<div
			class='z-[-2] absolute inset-0 bg-background w-full min-h-svh pointer-events-none'
			style='background-image: radial-gradient(ellipse 80% 70% at 50% -20%, oklch(var(--primary) / 0.24), transparent 60%), radial-gradient(ellipse 65% 60% at 78% -12%, oklch(var(--chart-2) / 0.18), transparent 62%), radial-gradient(ellipse 60% 55% at 15% 0%, oklch(var(--chart-3) / 0.12), transparent 58%);'></div>
		<slot />
	</body>
</html>
